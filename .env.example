# ============================================
# eSIM NL2SQL Platform - Environment Variables
# ============================================
# 复制此文件为 .env 并填写实际值

# --- Application ---
APP_NAME=eSIM NL2SQL Platform
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (MySQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=esim_platform_pass
DATABASE_NAME=esim_platform

# --- ChromaDB ---
CHROMADB_PERSIST_DIR=./chromadb_data
CHROMADB_COLLECTION_NAME=esim_nl2sql_rag
CHROMADB_PORT=8001

# --- LLM Configuration (DeepSeek-V3) ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Query Safety ---
QUERY_TIMEOUT_SECONDS=30
MAX_QUERY_ROWS=1000
QUERY_HISTORY_DAYS=90

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Audit ---
AUDIT_LOG_ENABLED=true

# --- CORS ---
# Comma-separated origins, e.g. http://localhost:5173,http://localhost:3000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Training ---
AUTO_INIT_TRAINING=true

# --- Query Cache ---
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=60
QUERY_CACHE_MAX_SIZE=200
# 缓存后端: memory(进程内) / redis(跨实例共享) / auto(优先Redis,失败降级内存)
QUERY_CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
